# Copy any of these into .env.development / .env.production (both are committed,
# since these values are public anyway - they end up in client-side HTML/JS regardless)
# or set the same names as Vercel project Environment Variables, which override the
# committed files at build time.

# Canonical site URL, no trailing slash. Used for canonical/OG/Twitter tags,
# JSON-LD, and the generated sitemap.xml + landing pages (scripts/generate-seo.js).
# Update this once a custom domain is connected.
REACT_APP_SITE_URL=https://passport-photo-maker-pi.vercel.app

# Your own GA4 measurement ID (e.g. G-XXXXXXXXXX) from a GA4 property you own.
# Leave empty to disable analytics entirely - the app no-ops if this is unset.
REACT_APP_GA_MEASUREMENT_ID=

# Your AdSense publisher client ID (e.g. ca-pub-XXXXXXXXXXXXXXXX), once approved.
# Leave empty to keep ads disabled - no ad script is injected if this is unset.
REACT_APP_ADSENSE_CLIENT_ID=

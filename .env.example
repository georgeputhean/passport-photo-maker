# Copy any of these into .env.development / .env.production (both are committed,
# since these values are public anyway - they end up in client-side HTML/JS regardless)
# or set the same names as Vercel project Environment Variables, which override the
# committed files at build time.

# Canonical site URL, no trailing slash. Used for canonical/OG/Twitter tags,
# JSON-LD, and the generated sitemap.xml + landing pages (scripts/generate-seo.js).
# Update this if the custom domain ever changes.
REACT_APP_SITE_URL=https://passportphotoedit.com

# Your own GA4 measurement ID (e.g. G-XXXXXXXXXX) from a GA4 property you own.
# Leave empty to disable analytics entirely - the app no-ops if this is unset.
REACT_APP_GA_MEASUREMENT_ID=

# Your AdSense publisher client ID (e.g. ca-pub-XXXXXXXXXXXXXXXX), once approved.
# Leave empty to keep ads disabled - no ad script is injected if this is unset.
REACT_APP_ADSENSE_CLIENT_ID=

# AdSense ad unit (slot) IDs for the two ad placements on the static /photos/*.html
# requirement pages (scripts/generate-seo.js) - an in-content slot after the "get it
# printed" section, and a slot near the bottom of the page. Both REACT_APP_ADSENSE_
# CLIENT_ID and the relevant slot ID must be set for that slot to go live; otherwise
# it renders as an inert placeholder box with no ad script loaded. These pages are
# never touched by src/App.js - the photo editor itself never shows ads.
REACT_APP_ADSENSE_SLOT_INCONTENT=
REACT_APP_ADSENSE_SLOT_FOOTER=

# Optional affiliate deep links for the "Get it printed nearby" section on each
# /photos/*.html page (print-at-retail partners). Leave empty to link to that
# retailer's plain (non-affiliate) passport-photo page instead - the section still
# renders either way, just without a tracked/commissioned link.
REACT_APP_AFFILIATE_WALGREENS_URL=
REACT_APP_AFFILIATE_CVS_URL=
REACT_APP_AFFILIATE_WALMART_URL=
REACT_APP_AFFILIATE_SHUTTERFLY_URL=
